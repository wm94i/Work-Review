{
  "name": "work-review",
  "private": true,
  "version": "1.2.0-rc.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test:components": "vitest run",
    "test:frontend": "node --import tsx --test \"**/*.test.ts\" && npm run test:components",
    "verify:frontend": "npm run check && npm run test:frontend && npm run build",
    "preview": "vite preview",
    "icons:build": "node --import tsx scripts/build-icons.ts",
    "icons:providers": "node --import tsx scripts/fetch-provider-icons.ts",
    "star-history": "node --import tsx scripts/capture-star-history.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:local-mac": "tauri build --target aarch64-apple-darwin --bundles app --config src-tauri/tauri.local.conf.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.20.1",
    "autoprefixer": "^10.4.0",
    "jsdom": "^26.1.0",
    "playwright": "1.61.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vite": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.4",
    "dompurify": "^3.4.17",
    "marked": "^18.2.1",
    "svelte-spa-router": "^5.1.1"
  }
}
